# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# validate_refs.py loads .env via python-dotenv. An already-exported
# GEMINI_API_KEY in your shell still takes precedence (load_dotenv does
# not override existing environment variables).
GEMINI_API_KEY=

# --- LoreCraft3000 app settings (all optional; defaults shown) ---

# Hard daily spend cap in USD (enforced in our own code before every call).
LORECRAFT_DAILY_SPEND_CAP_USD=3.0

# SQLite database path (relative to project root).
LORECRAFT_DB_PATH=data/lorecraft.db

# Content-addressed image store root (relative to project root).
LORECRAFT_STORE_ROOT=store

# Default model and image size.
LORECRAFT_DEFAULT_MODEL=gemini-3.1-flash-image
LORECRAFT_DEFAULT_IMAGE_SIZE=1K
