# Secrets — never commit
.env

# Virtual environment
.venv/

# Generated output
out/

# Local project documentation and agent state
documentation/

# Local reference inputs; keep only the directory placeholder in Git
refs/*
!refs/.gitkeep

# Content-addressed image store
store/

# Local SQLite database
data/

# OS metadata
.DS_Store

# Python
__pycache__/
*.py[cod]

# Frontend — installed packages and the production build.
# `npm run build` regenerates frontend/dist; app/main.py serves
# it when present but it is never checked into version control.
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
